<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{user.name}} Resume</title>
    <style>
        /* Helvetica-style sans serif */
        body {
            font-family: Arial, Helvetica, sans-serif;
            margin: 0;
            color: #141414;
            font-size: 12pt;
            line-height: 1.25;
            position: relative;
            min-height: 100vh;
            box-sizing: border-box;
            padding-bottom: 60px;
        }

        .text-center {
            text-align: center;
        }

        h1 {
            margin: 0;
            font-size: 28pt;
            font-weight: bold;
        }

        .contact-info {
            font-size: 11pt;
            margin-top: 5pt;
            margin-bottom: -3pt;
            text-align: center;
        }

        .contact-info a {
            color: inherit;
            text-decoration: none;
        }
        
        .contact-item {
            display: inline-flex;
            align-items: center;
            vertical-align: middle;
        }

        .icon {
            display: inline-flex;
            align-items: center;
            margin-right: 4px;
        }
        
        .sep {
            margin: 0 4px;
        }

        .section {
            margin-top: 10pt;
        }

        .section-title {
            font-weight: bold;
            font-size: 14pt;
            text-transform: uppercase;
            margin-bottom: 2pt;
            page-break-after: avoid;
            break-after: avoid;
        }

        .section-divider {
            border-bottom: 2pt solid #d4d4d4;
            margin-bottom: 4pt;
            page-break-after: avoid;
            break-after: avoid;
        }

        .item {
            margin-bottom: 8pt;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        /* Use simple tables for ATS layout extraction instead of Flexbox */
        .layout-table {
            width: 100%;
            border-collapse: collapse;
        }
        .layout-table td {
            padding: 0;
            vertical-align: top;
        }

        .item-title {
            font-weight: bold;
            text-align: left;
        }

        .item-date {
            color: #4d4d4d;
            font-size: 11pt;
            text-align: right;
            white-space: nowrap;
        }

        .layout-table td.item-subtitle {
            font-style: italic;
            text-align: left;
            padding-top: 4pt;
        }

        .layout-table td.item-location {
            color: #4d4d4d;
            font-size: 11pt;
            text-align: right;
            white-space: nowrap;
            padding-top: 4pt;
        }

        ul {
            margin-top: 10pt;
            margin-bottom: 0;
            padding-left: 0.15in;
            list-style-type: disc;
        }

        li {
            font-size: 11pt;
            margin-bottom: 1pt;
            padding-left: 0;
        }
        
        .skills-container {
            margin-top: 4pt;
            font-size: 11pt;
        }

        .skill-category {
            margin-bottom: 2pt;
        }
        
        .skill-name {
            font-weight: bold;
        }

        .cocpit-footer {
            position: fixed;
            right: -5px;
            bottom: -15px;
            width: 52px;
            height: 58px;
        }

        .cocpit-footer-logo {
            display: block;
            width: 52px;
            height: 58px;
        }
    </style>
</head>
<body>

    <div class="text-center">
        <h1>{{user.name}}</h1>
        <div class="contact-info">
            {{#each user.contactItems}}
                <span class="contact-item">
                    {{#if this.icon}}<span class="icon">{{{this.icon}}}</span>{{/if}}
                    {{#if this.url}}
                    <a href="{{this.url}}">{{this.display}}</a>
                    {{else}}
                    {{this.text}}
                    {{/if}}
                </span>
                {{#unless @last}}<span class="sep">|</span>{{/unless}}
            {{/each}}
        </div>
    </div>

    {{#if experiences.length}}
    <div class="section">
        <div class="section-title">EXPERIENCE</div>
        <div class="section-divider"></div>
        {{#each experiences}}
        <div class="item">
            <table class="layout-table">
                <tr>
                    <td class="item-title">{{company_name}}</td>
                    <td class="item-date">{{date_range}}</td>
                </tr>
                <tr>
                    <td class="item-subtitle">{{title}}</td>
                    <td class="item-location">{{location}}</td>
                </tr>
            </table>
            {{#if bullet_points.length}}
            <ul>
                {{#each bullet_points}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
            {{/if}}
        </div>
        {{/each}}
    </div>
    {{/if}}

    {{#if projects.length}}
    <div class="section">
        <div class="section-title">PROJECTS</div>
        <div class="section-divider"></div>
        {{#each projects}}
        <div class="item">
            <table class="layout-table">
                <tr>
                    <td class="item-title">{{name}}</td>
                    <td class="item-date">{{date_range}}</td>
                </tr>
            </table>
            {{#if bullet_points.length}}
            <ul>
                {{#each bullet_points}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
            {{/if}}
        </div>
        {{/each}}
    </div>
    {{/if}}

    {{#if educations.length}}
    <div class="section">
        <div class="section-title">EDUCATION</div>
        <div class="section-divider"></div>
        {{#each educations}}
        <div class="item">
            <table class="layout-table">
                <tr>
                    <td class="item-title">{{school_name}}</td>
                    <td class="item-date">{{date_range}}</td>
                </tr>
                <tr>
                    <td class="item-subtitle">{{degree}}{{#if field_of_study}} in {{field_of_study}}{{/if}}</td>
                    <td class="item-location">{{location}}</td>
                </tr>
            </table>
            {{#if bullet_points.length}}
            <ul>
                {{#each bullet_points}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
            {{/if}}
        </div>
        {{/each}}
    </div>
    {{/if}}

    {{#if skills.length}}
    <div class="section">
        <div class="section-title">SKILLS</div>
        <div class="section-divider"></div>
        <div class="skills-container">
            {{#each skills}}
            <div class="skill-category">
                <span class="skill-name">{{category}}:</span> {{items}}
            </div>
            {{/each}}
        </div>
    </div>
    {{/if}}

    <!-- Cocpit Logo Footer -->
    <div class="cocpit-footer">
        <svg class="cocpit-footer-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024" width="52" height="58" fill="none">
            <g fill="#000000">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M 678.68 262.00 L 729.00 261.69 L 731.47 263.00 L 731.21 361.00 L 729.00 362.60 L 699.00 363.96 L 684.00 366.09 L 659.00 372.63 L 648.00 377.29 L 637.00 383.88 L 627.00 392.12 L 620.32 400.00 L 611.55 415.00 L 607.00 429.26 L 604.78 441.00 L 603.28 459.00 L 602.66 539.00 L 600.00 539.94 L 476.52 540.00 L 475.46 538.00 L 474.78 520.00 L 474.79 414.00 L 476.68 393.00 L 481.00 370.17 L 485.29 357.00 L 490.00 346.24 L 500.36 330.00 L 515.00 314.07 L 533.66 299.00 L 552.27 288.00 L 573.00 279.30 L 594.00 272.68 L 615.00 268.18 L 648.00 263.92 L 678.68 262.00 Z M 290.82 462.00 L 410.47 462.00 L 411.34 464.00 L 410.90 542.00 L 413.63 564.00 L 418.28 579.00 L 424.77 592.00 L 438.00 608.84 L 454.97 622.00 L 467.00 628.44 L 484.00 635.03 L 500.00 639.26 L 533.00 643.33 L 601.00 643.71 L 603.00 644.79 L 603.00 758.41 L 598.00 759.52 L 531.00 758.55 L 471.00 754.55 L 440.00 750.09 L 417.00 743.54 L 388.00 730.68 L 361.00 713.33 L 340.00 695.54 L 322.68 676.00 L 314.00 662.90 L 303.00 638.72 L 294.06 609.00 L 289.94 573.00 L 289.91 464.00 L 290.82 462.00 Z" />
            </g>
        </svg>
    </div>
</body>
</html>
